{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hospital-cyber-game",
  "main": "src/server/worker.ts",
  "compatibility_date": "2026-10-27",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "assets": {
    "directory": "./dist-cloudflare",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/ws/*",
      "/host",
      "/host/*",
      "/host.html"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "GAME",
        "class_name": "GameEvent"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "GameEvent"
      ]
    }
  ],
  "observability": {
    "enabled": false
  }
}
