{
  "name": "hospital-cyber-game",
  "version": "1.14.2",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build && esbuild src/server/index.ts --bundle --platform=node --target=node24 --format=cjs --outfile=dist-server/game.cjs && esbuild src/server/cloud.ts --bundle --platform=node --target=node24 --format=cjs --outfile=dist-server/cloud.cjs",
    "start": "node scripts/launch.mjs",
    "start:local": "node scripts/launch.mjs --local-only",
    "test": "node --import tsx --test test/*.test.ts",
    "test:load": "node --import tsx test/load.ts",
    "package": "node scripts/package.mjs",
    "start:cloud": "node dist-server/cloud.cjs"
  },
  "dependencies": {
    "qrcode": "1.5.4",
    "socket.io": "4.8.1",
    "socket.io-client": "4.8.1"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/qrcode": "1.5.6",
    "esbuild": "0.25.12",
    "happy-dom": "20.14.5",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.2.2"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "license": "MIT"
}
